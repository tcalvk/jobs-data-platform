[Unit]
Description=Jobs Orchestrator Dagster daemon
After=network.target jobs-orchestrator-code.service
Requires=jobs-orchestrator-code.service
[Service]
Type=simple
User=dagster
Group=dagster
WorkingDirectory=/opt/jobs-data-platform/orchestration/jobs_orchestrator
Environment=DAGSTER_HOME=/var/lib/dagster
EnvironmentFile=/etc/jobs-orchestrator/environment
ExecStart=/opt/jobs-data-platform/.venv/bin/dagster-daemon run -w /var/lib/dagster/workspace.yaml
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
